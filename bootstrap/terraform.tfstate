            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ListLabState\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::keith-mccarthy-tf-state-lab\",\n      \"Principal\": {\n        \"AWS\": [\n          \"arn:aws:iam::482889161126:role/github-actions-plan\",\n          \"arn:aws:iam::482889161126:role/github-actions-apply\"\n        ]\n      },\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": \"lab/*\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadWriteLabState\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::keith-mccarthy-tf-state-lab/lab/*\",\n      \"Principal\": {\n        \"AWS\": [\n          \"arn:aws:iam::482889161126:role/github-actions-plan\",\n          \"arn:aws:iam::482889161126:role/github-actions-apply\"\n        ]\n      }\n    },\n    {\n      \"Sid\": \"DenyInsecureTransport\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:*\",\n      \"Resource\": [\n        \"arn:aws:s3:::keith-mccarthy-tf-state-lab/*\",\n        \"arn:aws:s3:::keith-mccarthy-tf-state-lab\"\n      ],\n      \"Principal\": \"*\",\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:SecureTransport\": \"false\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"ListLabState\",\"Effect\":\"Allow\",\"Action\":\"s3:ListBucket\",\"Resource\":\"arn:aws:s3:::keith-mccarthy-tf-state-lab\",\"Principal\":{\"AWS\":[\"arn:aws:iam::482889161126:role/github-actions-plan\",\"arn:aws:iam::482889161126:role/github-actions-apply\"]},\"Condition\":{\"StringLike\":{\"s3:prefix\":\"lab/*\"}}},{\"Sid\":\"ReadWriteLabState\",\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\",\"s3:GetObject\",\"s3:DeleteObject\"],\"Resource\":\"arn:aws:s3:::keith-mccarthy-tf-state-lab/lab/*\",\"Principal\":{\"AWS\":[\"arn:aws:iam::482889161126:role/github-actions-plan\",\"arn:aws:iam::482889161126:role/github-actions-apply\"]}},{\"Sid\":\"DenyInsecureTransport\",\"Effect\":\"Deny\",\"Action\":\"s3:*\",\"Resource\":[\"arn:aws:s3:::keith-mccarthy-tf-state-lab/*\",\"arn:aws:s3:::keith-mccarthy-tf-state-lab\"],\"Principal\":\"*\",\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\"}}}]}",
